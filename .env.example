# ══════════════════════════════════════════════════════════════════════════
# DepAPI — environment configuration
# Copy to .env, fill in DS_ADMIN_TOKEN, and never commit .env to git.
# ══════════════════════════════════════════════════════════════════════════

# ─── HTTP server ──────────────────────────────────────────────────────────
# Bind address. 127.0.0.1 = local only. 0.0.0.0 = all interfaces (use TLS!).
DS_HOST=127.0.0.1

# Port.
DS_PORT=8787

# ─── Storage ──────────────────────────────────────────────────────────────
# SQLite database path. Directory is created automatically.
# Use an absolute path if you want to share the DB between deployments.
DS_DB=data/server.db

# ─── Root admin token (REQUIRED) ──────────────────────────────────────────
# Used to authenticate as "root" against /admin/* endpoints.
# Send it via header:  X-Admin-Token: <value>
# MUST be at least 16 chars. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
DS_ADMIN_TOKEN=REPLACE_ME_WITH_64_RANDOM_CHARS

# ─── Defaults for new clients ─────────────────────────────────────────────
# Used when a client is created without explicit rps/daily values.
DS_DEFAULT_RPS=5
DS_DEFAULT_DAILY=1000

# ─── CORS ─────────────────────────────────────────────────────────────────
# Comma-separated origins for browser-based clients, or "*" for any (dev only).
# Leave empty to disable CORS middleware entirely (recommended for local-only).
# Example: DS_CORS_ORIGINS=https://app.example.com,https://admin.example.com
DS_CORS_ORIGINS=

# ─── Ban / proxy ──────────────────────────────────────────────────────────
# If set to 1/true, use X-Forwarded-For / X-Real-IP for client IP.
# Enable ONLY if behind a trusted reverse proxy (Caddy/nginx).
# Leave 0 when running directly — clients could spoof these headers.
DS_TRUST_PROXY=0